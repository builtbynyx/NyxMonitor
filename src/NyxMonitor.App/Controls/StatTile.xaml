<UserControl x:Class="NyxMonitor.App.Controls.StatTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root" MinWidth="130" Margin="0,0,28,14">
    <StackPanel>
        <TextBlock Text="{Binding Label, ElementName=Root}" Style="{StaticResource Text.Caption}"/>
        <TextBlock Text="{Binding Value, ElementName=Root}" Style="{StaticResource Text.Value}" Margin="0,2,0,0"/>
    </StackPanel>
</UserControl>
