<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:NyxMonitor.App.ViewModels"
                    xmlns:views="clr-namespace:NyxMonitor.App.Views">

    <!-- Page view-models -> views -->
    <DataTemplate DataType="{x:Type vm:OverviewViewModel}"><views:OverviewView/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:CpuViewModel}"><views:CpuView/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:GpuViewModel}"><views:GpuView/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:MemoryViewModel}"><views:MemoryView/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:StorageViewModel}"><views:StorageView/></DataTemplate>

    <!-- Sidebar entry -->
    <DataTemplate DataType="{x:Type vm:NavigationItem}">
        <TextBlock Text="{Binding Title}"/>
    </DataTemplate>

    <!-- One sensor: name on the left, value on the right -->
    <DataTemplate DataType="{x:Type vm:SensorItemViewModel}">
        <DockPanel Margin="0,0,0,8">
            <TextBlock DockPanel.Dock="Right" Text="{Binding ValueText}" FontWeight="SemiBold" Margin="16,0,0,0"/>
            <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
    </DataTemplate>

    <!-- One logical processor -->
    <DataTemplate DataType="{x:Type vm:CoreUsageViewModel}">
        <Border Width="150" Margin="0,0,10,10" Padding="12,10" CornerRadius="8"
                Background="{DynamicResource Brush.SurfaceHover}">
            <StackPanel>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Text}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Caption}"/>
                </DockPanel>
                <ProgressBar Style="{StaticResource Style.UsageBar}" Value="{Binding Percent, Mode=OneWay}" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- One drive (Storage page) -->
    <DataTemplate DataType="{x:Type vm:DriveViewModel}">
        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding UsedPercentText}" Style="{StaticResource Text.Value}"/>
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Section}"/>
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Caption}" Margin="0,2,0,0"/>
                    </StackPanel>
                </DockPanel>
                <ProgressBar Style="{StaticResource Style.UsageBar}" Value="{Binding UsedPercent, Mode=OneWay}"
                             Foreground="{Binding UsedPercent, Converter={StaticResource UsageToBrush}}" Margin="0,14,0,14"/>
                <WrapPanel>
                    <StackPanel Margin="0,0,28,0"><TextBlock Text="Used" Style="{StaticResource Text.Caption}"/><TextBlock Text="{Binding UsedText}" FontWeight="SemiBold"/></StackPanel>
                    <StackPanel Margin="0,0,28,0"><TextBlock Text="Free" Style="{StaticResource Text.Caption}"/><TextBlock Text="{Binding FreeText}" FontWeight="SemiBold"/></StackPanel>
                    <StackPanel Margin="0,0,28,0"><TextBlock Text="Capacity" Style="{StaticResource Text.Caption}"/><TextBlock Text="{Binding TotalText}" FontWeight="SemiBold"/></StackPanel>
                    <StackPanel Margin="0,0,28,0"><TextBlock Text="Read" Style="{StaticResource Text.Caption}"/><TextBlock Text="{Binding ReadText}" FontWeight="SemiBold"/></StackPanel>
                    <StackPanel><TextBlock Text="Write" Style="{StaticResource Text.Caption}"/><TextBlock Text="{Binding WriteText}" FontWeight="SemiBold"/></StackPanel>
                </WrapPanel>
            </StackPanel>
        </Border>
    </DataTemplate>

</ResourceDictionary>
