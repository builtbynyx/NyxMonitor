<UserControl x:Class="NyxMonitor.App.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:NyxMonitor.App.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="22,20,22,22">
            <TextBlock Text="Overview" Style="{StaticResource Text.PageTitle}" Margin="6,0,0,14"/>

            <UniformGrid x:Name="CardGrid" Columns="2">

                <!-- CPU -->
                <Border Style="{StaticResource Card}" Margin="6" DataContext="{Binding Cpu}">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="CPU" Style="{StaticResource Text.Section}"/>
                            <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right"
                                       TextTrimming="CharacterEllipsis" Margin="16,0,0,0"/>
                        </DockPanel>
                        <TextBlock Text="{Binding UsageText}" Style="{StaticResource Text.Hero}" Margin="0,8,0,0"/>
                        <controls:SparklineGraph Series="{Binding UsageHistory}" Maximum="100" Height="72" Margin="0,8,0,14"
                                                 Stroke="{DynamicResource Brush.Accent}"/>
                        <WrapPanel>
                            <controls:StatTile Label="Clock" Value="{Binding ClockText}" MinWidth="90" Margin="0,0,22,0"/>
                            <controls:StatTile Label="Temperature" Value="{Binding TemperatureText}" MinWidth="90" Margin="0,0,22,0"/>
                            <controls:StatTile Label="Cores / Threads" MinWidth="90" Margin="0">
                                <controls:StatTile.Value>
                                    <MultiBinding StringFormat="{}{0} / {1}">
                                        <Binding Path="CoresText"/>
                                        <Binding Path="ThreadsText"/>
                                    </MultiBinding>
                                </controls:StatTile.Value>
                            </controls:StatTile>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- GPU -->
                <Border Style="{StaticResource Card}" Margin="6" DataContext="{Binding Gpu}">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="GPU" Style="{StaticResource Text.Section}"/>
                            <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right"
                                       TextTrimming="CharacterEllipsis" Margin="16,0,0,0"/>
                        </DockPanel>
                        <TextBlock Text="{Binding UsageText}" Style="{StaticResource Text.Hero}" Margin="0,8,0,0"/>
                        <controls:SparklineGraph Series="{Binding UsageHistory}" Maximum="100" Height="72" Margin="0,8,0,14"
                                                 Stroke="{DynamicResource Brush.Accent}"/>
                        <WrapPanel>
                            <controls:StatTile Label="VRAM" Value="{Binding VramText}" MinWidth="90" Margin="0,0,22,0"/>
                            <controls:StatTile Label="Temperature" Value="{Binding TemperatureText}" MinWidth="90" Margin="0,0,22,0"/>
                            <controls:StatTile Label="Core clock" Value="{Binding CoreClockText}" MinWidth="90" Margin="0"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Memory -->
                <Border Style="{StaticResource Card}" Margin="6" DataContext="{Binding Memory}">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="Memory" Style="{StaticResource Text.Section}"/>
                            <TextBlock Text="{Binding DetailText}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right"
                                       TextTrimming="CharacterEllipsis" Margin="16,0,0,0"/>
                        </DockPanel>
                        <TextBlock Text="{Binding UsageText}" Style="{StaticResource Text.Hero}" Margin="0,8,0,0"/>
                        <controls:SparklineGraph Series="{Binding UsageHistory}" Maximum="100" Height="72" Margin="0,8,0,14"
                                                 Stroke="{DynamicResource Brush.Accent}"/>
                        <WrapPanel>
                            <controls:StatTile Label="In use" Value="{Binding UsedText}" MinWidth="90" Margin="0,0,22,0"/>
                            <controls:StatTile Label="Available" Value="{Binding AvailableText}" MinWidth="90" Margin="0,0,22,0"/>
                            <controls:StatTile Label="Installed" Value="{Binding InstalledText}" MinWidth="90" Margin="0"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Storage -->
                <Border Style="{StaticResource Card}" Margin="6" DataContext="{Binding Storage}">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="Storage" Style="{StaticResource Text.Section}"/>
                            <TextBlock Text="{Binding SummaryText}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right"
                                       TextTrimming="CharacterEllipsis" Margin="16,0,0,0"/>
                        </DockPanel>
                        <WrapPanel Margin="0,10,0,0">
                            <controls:StatTile Label="Read" Value="{Binding ReadText}" MinWidth="110" Margin="0,0,22,0"/>
                            <controls:StatTile Label="Write" Value="{Binding WriteText}" MinWidth="110" Margin="0"/>
                        </WrapPanel>
                        <controls:SparklineGraph Series="{Binding ReadHistory}" SecondarySeries="{Binding WriteHistory}"
                                                 AutoMaximumFloor="1048576" Height="48" Margin="0,0,0,12"
                                                 Stroke="{DynamicResource Brush.Accent}"/>
                        <ItemsControl ItemsSource="{Binding Drives}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,10">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Text.Caption}">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0} free of {1}">
                                                        <Binding Path="FreeText"/>
                                                        <Binding Path="TotalText"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                        <ProgressBar Style="{StaticResource Style.UsageBar}" Height="5" Margin="0,6,0,0"
                                                     Value="{Binding UsedPercent, Mode=OneWay}"
                                                     Foreground="{Binding UsedPercent, Converter={StaticResource UsageToBrush}}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            </UniformGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
