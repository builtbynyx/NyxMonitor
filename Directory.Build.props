<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.1.0</Version>
    <Authors>Nyx</Authors>
    <Company>BuiltByNyx</Company>
    <Product>NyxMonitor</Product>
    <Copyright>© 2026 Nyx / BuiltByNyx</Copyright>
    <RepositoryUrl>https://github.com/BuiltByNyx/NyxMonitor</RepositoryUrl>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
  </PropertyGroup>
</Project>
